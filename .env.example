# Server Configuration
PORT=3000
NODE_ENV=production

# -------------------------------------------------------------
# Database Configuration (MySQL / MariaDB / SQLite)
# -------------------------------------------------------------
# เลือกประเภทฐานข้อมูล:
# - DB_TYPE=mysql   : เชื่อมต่อไปยัง MySQL / MariaDB บน Host (เช่น phpMyAdmin / cPanel)
# - DB_TYPE=sqlite  : ใช้ไฟล์ฐานข้อมูล SQLite ใน data/lesson_plans.db (ค่าเริ่มต้น)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=ชื่อผู้ใช้_database
DB_PASSWORD=รหัสผ่าน_database
DB_NAME=ชื่อฐานข้อมูล_school
# หรือใช้ Connection String:
# DATABASE_URL=mysql://user:password@localhost:3306/school_lesson_plans

# -------------------------------------------------------------
# Google Drive Cloud Storage Configuration
# -------------------------------------------------------------
# วิธีเชื่อมต่อ Google Drive:
# 1. สร้าง Service Account ใน Google Cloud Console (https://console.cloud.google.com)
# 2. เปิดใช้งาน Google Drive API ในโปรเจกต์นั้น
# 3. สร้าง Key เป็นไฟล์ JSON แล้วนำมาวางไว้ที่โฟลเดอร์ เช่น credentials/service-account.json
# 4. สร้างโฟลเดอร์หลักใน Google Drive เช่น "แผนการสอน โรงเรียนสระหลวงพิทยาคม"
# 5. แชร์โฟลเดอร์หลักนั้นให้กับอีเมลของ Service Account (xxxx@xxxx.iam.gserviceaccount.com) โดยให้สิทธิ์เป็น "Editor (ผู้แก้ไข)"
# 6. คัดลอก Folder ID จาก URL บนบราวเซอร์มาใส่ใน GOOGLE_DRIVE_FOLDER_ID ด้านล่าง

# กำหนดพาธของไฟล์ Service Account JSON
GOOGLE_SERVICE_ACCOUNT_PATH=./credentials/service-account.json

# หรือใส่เนื้อหา JSON ทั้งก้อนในบรรทัดเดียว (กรณี Deploy บนคลาวด์/Render/Railway)
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","client_email":"..."}

# รหัสโฟลเดอร์หลักบน Google Drive ที่แชร์ให้ Service Account แล้ว
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here
